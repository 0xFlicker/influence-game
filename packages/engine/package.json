{
  "name": "@influence/engine",
  "version": "0.8.1",
  "description": "Influence game engine — core game logic, state machine, agents",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alliance-huddle-outcome": "./src/alliance-huddle-outcome.ts",
    "./agent-profile-contract": "./src/agent-profile-contract.ts",
    "./format-rules": "./src/format-rules.ts",
    "./format-presentation-metadata": "./src/format-presentation-metadata.ts",
    "./prompt-thread-lab": "./src/prompt-thread-lab.ts",
    "./prompt-thread-report": "./src/prompt-thread-report.ts",
    "./prompt-thread-worker": "./src/prompt-thread-worker.ts",
    "./model-defaults": "./src/model-defaults.ts",
    "./viewer-presentation": "./src/viewer-decision-events.ts",
    "./fixtures/format-kernel-viewer": "./src/fixtures/format-kernel-viewer.ts"
  },
  "scripts": {
    "simulate": "doppler run --project social-strategy-agent --config dev -- bun run src/simulate.ts",
    "simulate:local": "bun run src/simulate.ts",
    "simulate:api": "bun run src/api-simulate.ts",
    "evaluate:r32-provider-surfaces": "bun run src/scripts/evaluate-r32-provider-surfaces.ts",
    "compare:r32-provider-surfaces": "bun run src/scripts/compare-r32-provider-surfaces.ts",
    "simulate:katana:grok:smoke": "doppler run --project social-strategy-agent --config dev -- bun run src/simulate.ts --games 1 --players 6 --variant mingle --model-catalog katana:grok-4-3 --reasoning-policy low --game-timeout-sec 900 --llm-timeout-sec 120",
    "mcp:game": "bun run src/game-mcp/server.ts",
    "mcp:game:login": "bun run src/game-mcp/oauth-login.ts",
    "mcp:game:oauth": "bun run src/game-mcp/oauth-bridge.ts",
    "test": "bun test --config=../../bunfig.toml ./src --max-concurrency 1 --path-ignore-patterns='**/*live-provider*' --path-ignore-patterns='**/*external-smoke*'",
    "test:watch": "bun test --config=../../bunfig.toml ./src --watch --max-concurrency 1 --path-ignore-patterns='**/*live-provider*' --path-ignore-patterns='**/*external-smoke*'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "check": "bun run typecheck && bun run lint"
  },
  "dependencies": {
    "@influence/prompt-lab-protocol": "workspace:*",
    "ajv": "^8.17.1",
    "openai": "^4.77.0",
    "rxjs": "^7.8.2",
    "xstate": "^5.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "bun-types": "^1.3.10",
    "eslint": "^10.0.3",
    "typescript": "^5.8.3"
  }
}
