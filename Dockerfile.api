FROM oven/bun:1 AS base
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY package.json bun.lock bunfig.toml ./
COPY packages/api/package.json packages/api/
COPY packages/engine/package.json packages/engine/
COPY packages/prompt-lab-protocol/package.json packages/prompt-lab-protocol/
COPY packages/made-for-video/package.json packages/made-for-video/
COPY packages/web/package.json packages/web/
RUN bun install --frozen-lockfile --linker=isolated
# Preserve Sharp and its locked native dependency closure outside the JS bundle.
RUN mkdir /sharp-runtime \
  && cp -RL "$(dirname "$(readlink -f packages/api/node_modules/sharp)")/." /sharp-runtime/

# Build a single bundled file
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY package.json bun.lock bunfig.toml tsconfig.json ./
COPY packages/api/ packages/api/
COPY packages/engine/ packages/engine/
COPY packages/prompt-lab-protocol/ packages/prompt-lab-protocol/
COPY packages/web/package.json packages/web/

# Restore workspace-specific node_modules (bun creates symlinks into root .bun cache)
COPY --from=deps /app/packages/api/node_modules ./packages/api/node_modules
COPY --from=deps /app/packages/engine/node_modules ./packages/engine/node_modules

WORKDIR /app/packages/api
RUN bun build src/index.ts --target=bun --external sharp --outdir=dist --sourcemap=external \
  && bun build src/scripts/backfill-game-watch-state-summaries.ts --target=bun --external sharp --outdir=dist --entry-naming=backfill-game-watch-state-summaries.js --sourcemap=external \
  && bun build src/scripts/backfill-agent-revisions.ts --target=bun --external sharp --outdir=dist --entry-naming=backfill-agent-revisions.js --sourcemap=external \
  && bun build src/scripts/rotate-private-avatar-storage-keys.ts --target=bun --external sharp --outdir=dist --entry-naming=rotate-private-avatar-storage-keys.js --sourcemap=external \
  && bun build src/scripts/preflight-auth-identities.ts --target=bun --external sharp --outdir=dist --entry-naming=preflight-auth-identities.js --sourcemap=external \
  && bun build src/scripts/mint-deployment-control-token.ts --target=bun --external sharp --outdir=dist --entry-naming=mint-deployment-control-token.js --sourcemap=external \
  && bun build src/scripts/check-visual-runtime.ts --target=bun --external sharp --outdir=dist --sourcemap=external

# Slim runtime — only Sharp needs runtime node_modules
FROM oven/bun:1-slim AS runtime
WORKDIR /app

LABEL org.opencontainers.image.source=https://github.com/0xFlicker/influence-game \
  com.thehouse.influence.release-control-protocol="1"

COPY --from=build /app/packages/api/dist/ ./dist/
COPY --from=build /app/packages/api/drizzle/ ./drizzle/
COPY --from=build /app/packages/api/package.json ./
COPY --from=deps /sharp-runtime/ ./node_modules/
COPY packages/web/public/avatars/personas/ ./assets/personas/
ENV INFLUENCE_PERSONA_ASSET_DIR=/app/assets/personas
# Provider-free: decode every bundled default and exercise the native image library.
RUN bun dist/check-visual-runtime.js

ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}
ENV NODE_ENV=production
ENV PORT=3001
ENV HOST=0.0.0.0
ENV DRIZZLE_MIGRATIONS_DIR=/app/drizzle
# Production candidates override this to validation until the fenced release
# controller has accepted routing and activates the runtime.
ENV INFLUENCE_API_STARTUP_MODE=active
# The API image is a non-claiming gateway unless a dedicated game-worker
# deployment overrides this at runtime. Render workers use a separate image.
ENV INFLUENCE_API_ROLE=gateway
# Override at runtime to existing-only or full only when Doppler also injects
# CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY, CLERK_JWT_KEY, and
# CLERK_AUTHORIZED_PARTIES.
ENV MANAGED_AUTH_MODE=disabled
# Transitional legacy adoption is enabled through inventory/backfill. Set false
# only after a zero final delta; Privy login itself remains first-class.
ENV PRIVY_COMPATIBILITY_BRIDGE_ENABLED=true
# DATABASE_URL must be provided at runtime (e.g. via docker run -e or compose)

EXPOSE 3001

CMD ["bun", "run", "dist/index.js"]
